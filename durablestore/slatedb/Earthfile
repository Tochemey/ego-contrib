VERSION 0.8

FROM golang:1.26.0-alpine

# install gcc dependencies into alpine for CGO
RUN apk --no-cache add git ca-certificates gcc musl-dev libc-dev binutils-gold curl openssh

# install docker tools
# https://docs.docker.com/engine/install/debian/
RUN apk add --update --no-cache docker

# install rust toolchain to build the slatedb_uniffi shared library
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustc --version && cargo --version

# install linter
# binary will be $(go env GOPATH)/bin/golangci-lint
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b $(go env GOPATH)/bin v2.11.3
RUN golangci-lint --version

build-slatedb-lib:
    # Build the SlateDB Rust shared library pinned to the version matching the
    # Go binding (v0.16.0). This is required because the Go binding links
    # against libslatedb_uniffi at runtime.
    RUN git clone --depth 1 --branch v0.16.0 https://github.com/slatedb/slatedb.git /slatedb
    WORKDIR /slatedb
    RUN cargo build --package slatedb-uniffi
    SAVE ARTIFACT /slatedb/target/debug/libslatedb_uniffi.so /libs
    SAVE ARTIFACT /slatedb/target/debug/libslatedb_uniffi.dylib /libs

test:
  BUILD +lint
  BUILD +local-test

code:
    WORKDIR /app

    # download deps
    COPY go.mod go.sum ./
    RUN go mod download -x

    # copy in code
    COPY --dir . ./

vendor:
    FROM +code

    RUN go mod vendor
    SAVE ARTIFACT /app /files

lint:
    FROM +vendor

    COPY .golangci.yml ./
    # Runs golangci-lint with settings:
    RUN golangci-lint run --timeout 10m

local-test:
    FROM +vendor
    # bring in the built SlateDB shared library
    ARG +build-slatedb-lib

    ENV CGO_ENABLED=1
    ENV CGO_LDFLAGS="-L/libs"
    ENV LD_LIBRARY_PATH="/libs:${LD_LIBRARY_PATH}"
    ENV DYLD_LIBRARY_PATH="/libs:${DYLD_LIBRARY_PATH}"

    RUN go test -mod=vendor ./...  -timeout 0 -race -v  -coverprofile=coverage.out -covermode=atomic -coverpkg=./...

    SAVE ARTIFACT coverage.out AS LOCAL coverage.out
